    },
    {
      "id": "singularity.disk-speedtest"
    },
    {
      "id": "singularity.wifiqr"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.menu",
    "omarchy.idle",
    "omarchy.lock",
    "omarchy.background",
    "omarchy.speedtest",
    "omarchy.disk-speedtest",
    "omarchy.wifiqr"
  ],
  "cloneSourceRestores": [
    "singularity.menu",
    "singularity.idle",
    "singularity.lock",
    "singularity.background",
    "singularity.speedtest",
    "singularity.disk-speedtest",
    "singularity.wifiqr"
