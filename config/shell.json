{
  "bar": {
    "centerAnchor": "singularity.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "singularity.clock",
          "format": "dddd h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "singularity.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "singularity.menu"
        },
        {
          "id": "singularity.workspaces"
        }
      ],
      "right": [
        {
          "id": "singularity.tray"
        },
        {
          "id": "singularity.agents"
        },
        {
          "id": "singularity.bluetooth"
        },
        {
          "id": "singularity.network"
        },
        {
          "id": "singularity.audio"
        },
        {
          "id": "singularity.monitor"
        },
        {
          "id": "singularity.power"
        }
      ]
    },
    "position": "bottom",
    "transparent": false,
    "id": "singularity.bar"
  },
  "idle": {
    "lock": 900,
    "screensaver": 180
  },
  "plugins": [
    {
      "id": "singularity.idle"
    },
    {
      "id": "singularity.lock"
    },
    {
      "id": "singularity.background"
