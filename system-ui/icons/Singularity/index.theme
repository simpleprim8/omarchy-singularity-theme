[Icon Theme]
Name=Singularity
Comment=Original spacetime-inspired icons for the Singularity desktop
Inherits=Adwaita,Yaru-prussiangreen-dark,hicolor
Example=folder
Directories=scalable/places,scalable/mimetypes,scalable/devices,symbolic/places

[scalable/places]
Size=64
MinSize=16
MaxSize=256
Type=Scalable
Context=Places

[scalable/mimetypes]
Size=64
MinSize=16
MaxSize=256
Type=Scalable
Context=Mimetypes

[scalable/devices]
Size=64
MinSize=16
MaxSize=256
Type=Scalable
Context=Devices

[symbolic/places]
Size=16
MinSize=16
MaxSize=256
Type=Scalable
Context=Places
